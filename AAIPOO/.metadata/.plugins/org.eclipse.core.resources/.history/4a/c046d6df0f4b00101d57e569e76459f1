package controller;

import model.RelatorioDAO;
import java.util.List;
import model.Relatorio;

public class RelatorioController {
	RelatorioDAO dao = new RelatorioDAO();
	
	public List<Relatorio> todas(){
		return dao.todas(); 
	}
	
	public List<Relatorio> produto(String produto){
		return dao.produto(produto); 
	}
	
	public List<Relatorio> cliente(String cliente){
		return dao.cliente(cliente); 
	}
	
	public List<Relatorio> valor(int valor){
		return dao.valor(valor); 
	}
	
	public List<Relatorio> maiorLucro(){
		return dao.maiorLucro(); 
	}
	
	public List<Relatorio> menorLucro(){
		return dao.menorLucro(); 
	}
}
