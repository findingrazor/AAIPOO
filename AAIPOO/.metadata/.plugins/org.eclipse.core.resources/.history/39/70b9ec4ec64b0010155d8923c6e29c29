package controller;

import java.util.List;

import model.Produto;
import model.Vendas;
import model.VendasDAO;

public class VendasController {
	VendasDAO dao = new VendasDAO();

	public boolean salvar(String cliente, String produto, int qntdProd, float valorUni, float desconto, String formaPag,
			float valorTotal ) {
		Vendas vendas = new Vendas(cliente, produto, qntdProd, valorUni, desconto, formaPag, valorTotal);
		return dao.salvar(vendas);
	}
	
	public boolean deletar(String cliente, String produto) {
		return dao.deletar(cliente, produto);
	}
	
	public  List<Vendas> listar(){
		return dao.listar();
	}
}
