public class RelatorioDAO {
	public List<Relatorio> todas() {
		List<Relatorio> lista = new ArrayList<>();
        String sql = "SELECT C.nome AS nomeCliente, P.nome AS nomeProduto, Pe.codPedido, D.qntdProd, D.desconto, F.formaPag, D.valorTotal\r\n"
        		+ "FROM detalhes D INNER JOIN produto P ON P.codProduto = D.codProduto\r\n"
        		+ "INNER JOIN pedido Pe ON Pe.codPedido = D.codPedido\r\n"
        		+ "INNER JOIN cliente C ON C.codCliente = Pe.codCliente\r\n"
        		+ "INNER JOIN pagamento F ON Pe.codPag = F.codPag;";
        Conexao.conectar();
        try (Connection conn = Conexao.conexao;
             PreparedStatement stmt = conn.prepareStatement(sql);
             ResultSet rs = stmt.executeQuery()) {
            while (rs.next()) {
                Relatorio relatorio = new Relatorio(
                    rs.getString("nomeCliente"),
                    rs.getString("nomeProduto"),
                    rs.getInt("codPedido"),
                    rs.getFloat("qntdProd"),
                    rs.getFloat("desconto"),
                    rs.getString("formaPag"),
                    rs.getFloat("valorTotal")
                );
                lista.add(relatorio);
            }
        } catch (SQLException e) {
            e.printStackTrace();
        }
        return lista;
	}
	
