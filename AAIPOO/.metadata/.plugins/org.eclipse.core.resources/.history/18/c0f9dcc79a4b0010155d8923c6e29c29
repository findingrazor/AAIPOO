package model;

import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.util.ArrayList;
import java.util.List;

import javax.swing.JOptionPane;

public class ClienteDAO {
	public boolean salvar(Cliente cliente) {
	    String sqlVerifica = "SELECT 1 FROM Cliente WHERE CPF = ?";
	    String sql = "INSERT INTO Cliente(Nome, CPF, Email, Telefone, Endereco) VALUES (?, ?, ?, ?, ?)";
	    Conexao.conectar();

	    try (Connection conn = Conexao.conexao) {
	        try (PreparedStatement stmtVerifica = conn.prepareStatement(sqlVerifica)) {
	            stmtVerifica.setString(1, cliente.getCpf());
	            ResultSet rs = stmtVerifica.executeQuery();
	            if (rs.next()) {
	                return false;
	            }
	        }
	        try (PreparedStatement stmt = conn.prepareStatement(sql)) {
	            stmt.setString(1, cliente.getNome());
	            stmt.setString(2, cliente.getCpf());
	            stmt.setString(3, cliente.getEmail());
	            stmt.setString(4, cliente.getTelefone());
	            stmt.setString(5, cliente.getEndereco());
	            stmt.executeUpdate();
	            Conexao.desconectar();
	            return true;
	        }
	        
	    } catch (SQLException e) {
	        e.printStackTrace();
	    }
	    Conexao.desconectar();
	    return false;
	}

	
	public boolean deletarPorCpf(String cpf) {
	    String buscarId = "SELECT codCliente FROM Cliente WHERE CPF = ?";
	    String deletarDetalhes = "DELETE FROM Detalhes WHERE codPedido IN (SELECT codPedido FROM Pedido WHERE codCliente = ?)";
	    String deletarPedidos = "DELETE FROM Pedido WHERE codCliente = ?";
	    String deletarCliente = "DELETE FROM Cliente WHERE CPF = ?";

	    Conexao.conectar();

	    try (Connection conn = Conexao.conexao;
	         PreparedStatement stmtBuscar = conn.prepareStatement(buscarId)) {

	        
	        stmtBuscar.setString(1, cpf);
	        ResultSet rs = stmtBuscar.executeQuery();
	        if (!rs.next()) {
	            return false; 
	        }
	        int codCliente = rs.getInt("codCliente");

	       
	        try (PreparedStatement stmtDetalhes = conn.prepareStatement(deletarDetalhes)) {
	            stmtDetalhes.setInt(1, codCliente);
	            stmtDetalhes.executeUpdate();
	        }

	        
	        try (PreparedStatement stmtPedidos = conn.prepareStatement(deletarPedidos)) {
	            stmtPedidos.setInt(1, codCliente);
	            stmtPedidos.executeUpdate();
	        }

	       
	        try (PreparedStatement stmtCliente = conn.prepareStatement(deletarCliente)) {
	            stmtCliente.setString(1, cpf);
	            int linhasAfetadas = stmtCliente.executeUpdate();
	            return linhasAfetadas > 0;
	        }

	    } catch (SQLException e) {
	        e.printStackTrace();
	    } finally {
	        Conexao.desconectar();
	    }
	    return false;
	}


	
	public boolean atualizar(Cliente cliente) {
		String sql = "UPDATE cliente SET Nome = ?, Email = ?, Telefone = ?, Endereco = ? "
				+ "WHERE CPF = ?";
		Conexao.conectar();
		try(Connection conn = Conexao.conexao; PreparedStatement stmt = conn.prepareStatement(sql)){
			stmt.setString(1, cliente.getNome());
			stmt.setString(2, cliente.getEmail());
			stmt.setString(3, cliente.getTelefone());
			stmt.setString(4, cliente.getEndereco());
			stmt.setString(5, cliente.getCpf());
			int linhasAfetadas = stmt.executeUpdate();
            if (linhasAfetadas > 0) {
            	return true;
            }
        } catch (SQLException e) {
            e.printStackTrace();
        } finally {
        	Conexao.desconectar();
        }
        return false;
	}
	
	public Cliente carregar(String cpf) {
		Cliente cliente = null;
		String sql = "SELECT * FROM Cliente WHERE CPF = ?";
        Conexao.conectar();
        try (Connection conn = Conexao.conexao;
             PreparedStatement stmt = conn.prepareStatement(sql)){
        	stmt.setString(1, cpf);
            ResultSet rs = stmt.executeQuery();
            while (rs.next()) {
                cliente = new Cliente(
                    rs.getString("Nome"),
                    rs.getString("cpf"),
                    rs.getString("email"),
                    rs.getString("telefone"),
                    rs.getString("endereco")   
                );
            }        
            } catch (SQLException e) {
            e.printStackTrace();
        }
        Conexao.desconectar();
        return cliente;
    }
	
	public List<Cliente> listar() {
		List<Cliente> lista = new ArrayList<>();
        String sql = "SELECT * FROM cliente";
        Conexao.conectar();
        try (Connection conn = Conexao.conexao;
             PreparedStatement stmt = conn.prepareStatement(sql);
             ResultSet rs = stmt.executeQuery()) {
            while (rs.next()) {
                Cliente cliente = new Cliente(
                    rs.getString("nome"),
                    rs.getString("cpf"),
                    rs.getString("email"),
                    rs.getString("telefone"),
                    rs.getString("endereco")
                );
                lista.add(cliente);
            }
        } catch (SQLException e) {
            e.printStackTrace();
        }
        Conexao.desconectar();
        return lista;
	}
}
