package controller;

import model.RelatorioDAO;
import java.util.List;
import model.Detalhes;

public class RelatorioController {
	RelatorioDAO dao = new RelatorioDAO();
	
	public List<Detalhes> todas(){
		return dao.todas(); 
	}
	
	public List<Detalhes> produto(String produto){
		return dao.produto(produto); 
	}
	
	public List<Detalhes> cliente(String cliente){
		return dao.cliente(cliente); 
	}
	
	public List<Detalhes> valor(int valor){
		return dao.valor(valor); 
	}
	
	public List<Detalhes> maiorLucro(){
		return dao.maiorLucro(); 
	}
	
	public List<Detalhes> menorLucro(){
		return dao.menorLucro(); 
	}
}
