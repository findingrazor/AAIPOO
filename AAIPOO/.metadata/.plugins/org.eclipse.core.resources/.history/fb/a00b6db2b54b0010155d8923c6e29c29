package controller;

import model.Vendas;
import model.VendasDAO;

public class VendasController {
	VendasDAO dao = new VendasDAO();

	public void salvar(String cliente, String produto, int qntdProd, float valorUni, float desconto, String formaPag,
			float valorTotal ) {
		Vendas vendas = new Vendas(cliente, produto, qntdProd, valorUni, desconto, formaPag, valorTotal);
		dao.salvar(vendas);
	}
	
	
}
