	private boolean salvar() {
		if(!naoVazio() || !validar()) {
			return false;
		}
		
		boolean salvo = controller.salvar(textFieldProduto.getText(), comboBoxMidia.getSelectedItem().toString(),comboBoxGenero.getSelectedItem().toString(), 
				Integer.parseInt(textFieldEstoque.getText()) , Float.parseFloat(textFieldPreço.getText()) );
		
		if(!salvo) {
			JOptionPane.showMessageDialog(null, "Erro, já existe um produto com esse nome e essa mídia");
			return false;
		}else {
			JOptionPane.showMessageDialog(null, "O cadastro foi realizado com sucesso!");
			limpar();
			listar();
			return true;
		}
	}
	
	private void limpar() {
		textFieldProduto.setText("");
		comboBoxMidia.setSelectedIndex(0);
		comboBoxGenero.setSelectedIndex(0);
		textFieldEstoque.setText("");
		textFieldPreço.setText("");
	}
	
	private boolean deletar() {
		String nome = textFieldProduto.getText();
		String midia = (String) comboBoxMidia.getSelectedItem();
		if(textFieldProduto.getText().isBlank() || comboBoxMidia.getSelectedItem().equals("Selecione um tipo")) {
			nome = JOptionPane.showInputDialog("Digite o Produto que deseja deletar: ",null);
			midia = JOptionPane.showInputDialog("Digite a midia que deseja deletar: ", null);
		}
		
		boolean deletado = controller.deletar(nome,midia);
		
		if (!deletado) {
			JOptionPane.showMessageDialog(null, "Produto não encontrado, por favor digite um Produto cadastrado ou válido");
			return false;
		} else {
			JOptionPane.showMessageDialog(null, "O cadastro foi deletado com sucesso!");
			limpar();
			listar();
			return true;
		}
	}
	
	private boolean atualizar() {
		String nome = textFieldProduto.getText();
		String midia = comboBoxMidia.getSelectedItem().toString();

		
		if (nome.isBlank() || midia.equals("Selecione um tipo")) {
			nome = JOptionPane.showInputDialog("Digite o Produto que deseja atualizar:", null);
			midia = JOptionPane.showInputDialog("Digite a mídia que deseja atualizar:", null);
			textFieldProduto.setText(nome);
			comboBoxMidia.setSelectedItem(midia);
		}
		
		if(!naoVazio() || !validar()) {
			return false;
		}
		
		boolean atualizado = controller.atualizar(nome, midia, comboBoxGenero.getSelectedItem().toString(), 
			Integer.parseInt(textFieldEstoque.getText()), Float.parseFloat(textFieldPreço.getText()) );
			
			
			if (!atualizado) {
				JOptionPane.showMessageDialog(null, "Produto não encontrado, por favor digite um Produto cadastrado ou válido");
				return false;
			} else {
				JOptionPane.showMessageDialog(null, "O cadastro foi atualizado com sucesso!");
				limpar();
				listar();
				return true;
			}
	}
	
	private void carregarComboMidia() {
		List<Midia> midias = controllerMidia.listar();

		comboBoxMidia.addItem("Selecione um tipo");
		for (Midia u : midias) {
			comboBoxMidia.addItem(u.getMidia());
		}
	}
	
	private void carregarComboGenero() {
		List<Genero> genero = controllerGenero.listarG();
		
		comboBoxGenero.addItem("Selecione um genero musical");
		for (Genero u : genero) {
			comboBoxGenero.addItem(u.getGenero());
		}
	}
	
	private void listar() {
		modelo.setRowCount(0);
		List<Produto> produto = controller.listar();
		
		for (Produto u : produto) {
			Object[] row = { u.getProduto(), u.getMidia(), u.getGenero(), u.getEstoque(), u.getPreço()};
			modelo.addRow(row);
		}
		tblResultados.setModel(modelo);
	}
	
	private Produto carregar() {
		String nome = JOptionPane.showInputDialog("Digite o nome do Produto que deseja carregar: ",null);
		String midia = JOptionPane.showInputDialog("Digite a mídia do Produto que deseja carregar: ",null);
		Produto produto = controller.carregar(nome, midia);
		
		textFieldProduto.setText(produto.getGenero());
		textFieldPreço.setText(String.valueOf(produto.getPreço()));
		textFieldEstoque.setText(String.valueOf(produto.getEstoque()));
		comboBoxGenero.setSelectedItem(produto.getGenero());
		comboBoxMidia.setSelectedItem(produto.getMidia());
		
		return produto;
	}
	
	private boolean naoVazio() {
		JTextField[] campos = { textFieldProduto, textFieldPreço, textFieldEstoque };
		JComboBox [] combos = { comboBoxGenero, comboBoxMidia};
		String[] nomesCampos = { "Produto", "Preço", "Estoque" };
		String[] nomesCombos = {"Gênero", "Mídia"};
		for (int i = 0; i < campos.length; i++) {
			if (campos[i].getText().isBlank()) {
				JOptionPane.showMessageDialog(null, "O campo " + nomesCampos[i] + " está vazio, por favor, preencha-o");
				return false;
			}
		}
		
		for (int i = 0; i < combos.length; i++) {
			if(comboBoxGenero.getSelectedItem().equals("Selecione um tipo") || comboBoxMidia.getSelectedItem().equals("Selecione um genero musical")) {
				JOptionPane.showMessageDialog(null, "O campo " + nomesCombos[i] + " está vazio, por favor, preencha-o");
				return false;
			}
		}
		return true;
	}

	private boolean validar() {
		JTextField[] campos = { textFieldProduto, textFieldPreço, textFieldEstoque };
		JComboBox [] combos = { comboBoxGenero, comboBoxMidia};
		
		if (!campos[0].getText().matches("\\d+")) {
			JOptionPane.showMessageDialog(null, "Preço inválido, por favor digite apenas números");
			return false;
		} 
		
		if (campos[1].getText().matches("\\d+")) {
			JOptionPane.showMessageDialog(null, "Estoque inválido, por favor digite apenas números");
			return false;
		}

		if(comboBoxGenero.getSelectedItem().equals("Selecione um tipo") || comboBoxMidia.getSelectedItem().equals("Selecione um genero musical")) {
			JOptionPane.showMessageDialog(null, "O campo Midia está vazio, por favor, preencha-o");
			return false;
		}
		
		if(comboBoxGenero.getSelectedItem().equals("Selecione um tipo") || comboBoxMidia.getSelectedItem().equals("Selecione um genero musical")) {
			JOptionPane.showMessageDialog(null, "O campo Genero está vazio, por favor, preencha-o");
			return false;
		}

		return true;
	}
