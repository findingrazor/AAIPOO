	private void todas() {
		modelo.setRowCount(0);
		List<Relatorio> relatorio = controller.todas();
		
		if(relatorio.isEmpty()) {
			JOptionPane.showMessageDialog(null, "Nenhuma venda foi encontrada!");
		}else {
			for (Relatorio u : relatorio) {
				Object[] row = { u.getNomeCliente(), u.getNomeProduto(), u.getCodPedido(), u.getQntdProd(), u.getDesconto(), u.getFormaPag(), u.getValorTotal() };
				modelo.addRow(row);
			}
			tblResultados.setModel(modelo);
		}
	}
	
