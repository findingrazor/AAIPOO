		JLabel lblLogo = new JLabel();
		lblLogo.setBounds(52, 11, 200, 200);
		
		try {
            BufferedImage imagemOriginal = ImageIO.read(getClass().getResource("/images/logo_nome.png"));

            BufferedImage imagemRedimensionada = new BufferedImage(
                lblLogo.getWidth(), lblLogo.getHeight(), BufferedImage.TYPE_INT_ARGB
            );

            Graphics2D g2d = imagemRedimensionada.createGraphics();
            g2d.setRenderingHint(RenderingHints.KEY_INTERPOLATION, RenderingHints.VALUE_INTERPOLATION_BILINEAR);
            g2d.drawImage(imagemOriginal, 0, 0, lblLogo.getWidth(), lblLogo.getHeight(), null);
            g2d.dispose();

            lblLogo.setIcon(new ImageIcon(imagemRedimensionada));
        } catch (IOException e) {
            e.printStackTrace();
        }

        frame.getContentPane().add(lblLogo);
