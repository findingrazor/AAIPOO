package controller;

import model.Vendas;
import model.VendasDAO;

public class VendasController {
	VendasDAO dao = new VendasDAO();

	public void salvar(int codPedido, int codProduto, int codCliente, int produto, int qntdProd, float valorUni, float desconto, float valorTotal ) {
		Vendas vendas = new Vendas(codPedido, codProduto, codCliente, produto, qntdProd, valorUni, desconto, valorTotal);
		dao.salvar(vendas);
	}
	
	
}
