	public boolean salvar() {
		if(!naoVazio() || !validar()) {
			return false;
		}
		
		boolean salvo = controller.salvar(textFieldCliente.getText(), textFieldProduto.getText(), Integer.parseInt(textFieldQntdProduto.getText()), 
				Float.parseFloat(textFieldUnidade.getText()) , Float.parseFloat(textFieldDesconto.getText()), 
				comboBoxPag.getSelectedItem().toString(), Float.parseFloat(textFieldTotal.getText()));
		
		if(!salvo) {
			JOptionPane.showMessageDialog(null, "Erro, já existe um produto com esse nome e essa mídia");
			return false;
		}else {
			JOptionPane.showMessageDialog(null, "O cadastro foi realizado com sucesso!");
			limpar();
			listar();
			return true;
		}
	}
	
	public void limpar() {
		textFieldCliente.setText("");
		textFieldProduto.setText("");
		textFieldQntdProduto.setText("");
		textFieldUnidade.setText("");
		textFieldDesconto.setText(""); 
		comboBoxPag.setSelectedIndex(0);
		textFieldTotal.setText("");
	}
	
	public boolean deletar() {
		String cliente = textFieldCliente.getText();
		String produto = textFieldProduto.getText();
		if(textFieldCliente.getText().isBlank() || textFieldProduto.getText().isBlank()) {
			cliente = JOptionPane.showInputDialog("Digite o nome do Cliente que deseja deletar: ",null);
			produto = JOptionPane.showInputDialog("Digite o nome do Produto que deseja deletar: ",null);
		} 
		
		boolean deletado = controller.deletar(cliente,produto);
		
		if (!deletado) {
			JOptionPane.showMessageDialog(null, "Venda não encontrada, por favor digite dados de uma Venda cadastrada ou válida");
			return false;
		} else {
			JOptionPane.showMessageDialog(null, "O cadastro foi deletado com sucesso!");
			limpar();
			listar();
			return true;
		}
	}
	
	public void listar() {
		modelo.setRowCount(0);
		List<Vendas> vendas = controller.listar();
		
		for (Vendas u : vendas) {
			Object[] row = { u.getCliente(), u.getProduto(), u.getQntdProd(), u.getValorUni(), u.getDesconto(), u.getFormaPag(), u.getValorTotal()};
			modelo.addRow(row);
		}
		tblResultados.setModel(modelo);
	}
	
	private Cliente carregar() {
		String cpf = JOptionPane.showInputDialog("Digite o CPF que deseja carregar: ",null);
		Cliente cliente = controller.carregar(cpf);
		
		
		textFieldNome.setText(cliente.getNome());
		textFieldCPF.setText(cliente.getCpf());
		textFieldEmail.setText(cliente.getEmail());
		textFieldEndereço.setText(cliente.getEndereco());
		textFieldTelefone.setText(cliente.getTelefone());
		
		return cliente;
	}
	public boolean atualizar() {	
		if(textFieldCPF.getText().isBlank()) {
			String cpf = JOptionPane.showInputDialog("Digite o CPF que atualizar: ",null);
			textFieldCPF.setText(cpf);
		}
		
		if(!naoVazio() || !validar()) {
			return false;
		}
		
		boolean atualizado = controller.atualizar(textFieldNome.getText(), textFieldCPF.getText(), textFieldEmail.getText(),
					textFieldTelefone.getText(), textFieldEndereço.getText());
			
			if (!atualizado) {
				JOptionPane.showMessageDialog(null, "CPF não encontrado, por favor digite um CPF cadastrado ou válido");
				return false;
			} else {
				JOptionPane.showMessageDialog(null, "O cadastro foi atualizado com sucesso!");
				limpar();
				listar();
				return true;
			}		
	}
	
	private void carregarComboPag(){
		List<FormaPag> formaPag = controllerPag.listar();
		
		comboBoxPag.addItem("Selecione uma forma de pagamento");
		for (FormaPag u : formaPag) {
			comboBoxPag.addItem(u.getFormaPag());
		}
	}
	
	public boolean naoVazio() {
		JTextField[] campos = { textFieldCliente, textFieldProduto, textFieldQntdProduto, textFieldUnidade, textFieldDesconto, textFieldTotal };
		JComboBox[] combos = { comboBoxPag };
		String[] nomesCampos = { "Cliente", "Produto", "Quantidade", "Valor Unitário", "Desconto", "Total" };
		String[] nomesCombos = {"Pagamento"};
		for (int i = 0; i < campos.length; i++) {
			if (campos[i].getText().isBlank()) {
				JOptionPane.showMessageDialog(null, "O campo " + nomesCampos[i] + " está vazio, por favor, preencha-o");
				return false;
			}
		}
		
		for (int i = 0; i < combos.length; i++) {
			if(combos[i].getSelectedItem().equals("Selecione uma forma de pagamento")) {
				JOptionPane.showMessageDialog(null, "O campo " + nomesCombos[i] + " está vazio, por favor, preencha-o");
				return false;
			}
		}
		return true;
	}

	public boolean validar() {
		JTextField[] campos = { textFieldCliente, textFieldProduto, textFieldQntdProduto, textFieldUnidade, textFieldDesconto, textFieldTotal };
		
		if (campos[0].getText().matches("\\d+")) {
			JOptionPane.showMessageDialog(null, "Cliente inválido, por favor digite apenas letras");
			return false;
		} 
		
		if (!campos[2].getText().matches("\\d+")) {
			JOptionPane.showMessageDialog(null, "Quantidade inválida, por favor digite apenas números");
			return false;
		} 
		
		if (!campos[3].getText().matches("\\d+")) {
			JOptionPane.showMessageDialog(null, "Valor unitário inválido, por favor digite apenas números");
			return false;
		}

		if(!campos[4].getText().matches("\\d+")) {
			JOptionPane.showMessageDialog(null, "Desconto inválido, por favor digite apenas números");
			return false;
		}
		
		if(!campos[5].getText().matches("\\d+")) {
			JOptionPane.showMessageDialog(null, "Valor Total inválido, por favor digite apenas números");
			return false;
		}
		

		return true;
	}
