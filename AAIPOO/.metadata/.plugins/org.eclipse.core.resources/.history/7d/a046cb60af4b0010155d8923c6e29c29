public final class ProdutoDAO {
	private MidiaController controllerMidia = new MidiaController();
	List<Midia> midias = controllerMidia.listar();
	private GeneroController controllerGenero = new GeneroController();
	List<Genero> generos = controllerGenero.listarG();
	
	public boolean salvar(Produto produto) {
		String sqlVerifica = "SELECT 1 FROM produto WHERE nome = ? AND codMidia = ?";
	    String sql = "INSERT INTO Produto(nome, codMidia, codGenero, qntdEstoque, Preco) VALUES (?, ?, ?, ?, ?)";
	    Conexao.conectar();
	    
	        try (Connection conn = Conexao.conexao) {
	        	try(PreparedStatement stmtVerifica = conn.prepareStatement(sqlVerifica)){
	        		stmtVerifica.setString(1, produto.getProduto());
	        		int idMidia = -1;
	        		for (Midia m : midias) {
	     	            if (m.getMidia().equalsIgnoreCase(produto.getMidia())) {
	     	                idMidia = m.getCodMidia();
	     	                break;
	     	            }
	     	        }
	        		stmtVerifica.setInt(2, idMidia);
		            ResultSet rs = stmtVerifica.executeQuery();
		            if (rs.next()) {
		                return false;
		            }
	        	}
	        
	        	 try (PreparedStatement stmt = conn.prepareStatement(sql)) {
	     	        stmt.setString(1, produto.getProduto());
	     	        int idMidia = -1;
	     	        for (Midia m : midias) {
	     	            if (m.getMidia().equalsIgnoreCase(produto.getMidia())) {
	     	                idMidia = m.getCodMidia();
	     	                break;
	     	            }
	     	        }
	     	        if (idMidia == -1) {
	     	            JOptionPane.showMessageDialog(null, "Mídia '" + produto.getMidia() + "' não encontrada!");
	     	            return false;
	     	        }

	     	        stmt.setInt(2, idMidia);
	     	        int idGenero = -1;
	     	        for (Genero g : generos) {
	     	            if (g.getGenero().equalsIgnoreCase(produto.getGenero())) {
	     	                idGenero = g.getCodGenero();
	     	                break;
	     	            }
	     	        }
	     	        if (idGenero == -1) {
	     	            JOptionPane.showMessageDialog(null, "Gênero '" + produto.getGenero() + "' não encontrado!");
	     	            return false;
	     	        }
	     	        stmt.setInt(3, idGenero);
	     	        stmt.setInt(4, produto.getEstoque());
	     	        stmt.setFloat(5, produto.getPreço());
	     	        stmt.executeUpdate();
	     	        Conexao.desconectar();
	     	        return true;
	        	 }
	    } catch (SQLException e) {
	        e.printStackTrace();
	    }
	        return false; 
	}

	
	public boolean deleter(String nome, String midia) {
		String sql = "DELETE FROM produto WHERE nome = ? AND codMidia = ?";
		Conexao.conectar();
		try(Connection conn = Conexao.conexao; PreparedStatement stmt = conn.prepareStatement(sql)) {
			stmt.setString(1, nome);
			int idMidia = -1;
    		for (Midia m : midias) {
 	            if (m.getMidia().equalsIgnoreCase(midia)) {
 	                idMidia = m.getCodMidia();
 	                break;
 	            }
 	        }
    		stmt.setInt(2, idMidia);
			int linhasAfetadas = stmt.executeUpdate();
			if (linhasAfetadas > 0) {
				return true;
			} 
		} catch (SQLException e) {
			e.printStackTrace();
		} finally {
			Conexao.desconectar();
		}
		return false;
	}
	
	
	public boolean atualizar(Produto produto) {
	    String sql = "UPDATE produto SET nome = ?, codMidia = ?, codGenero = ?, qntdEstoque = ?, preco = ? WHERE nome = ? AND codMidia = ?";
	    Conexao.conectar();


	    try (Connection conn = Conexao.conexao;
	         PreparedStatement stmt = conn.prepareStatement(sql)) {

	        int idNovaMidia = -1;
	        for (Midia m : midias) {
	            if (m.getMidia().equalsIgnoreCase(produto.getMidia())) {
	                idNovaMidia = m.getCodMidia();
	                break;
	            }
	        }
	        if (idNovaMidia == -1) {
	            JOptionPane.showMessageDialog(null, "Mídia '" + produto.getMidia() + "' não encontrada!");
	            return false;
	        }

	        // Pega ID do gênero
	        int idGenero = -1;
	        for (Genero g : generos) {
	            if (g.getGenero().equalsIgnoreCase(produto.getGenero())) {
	                idGenero = g.getCodGenero();
	                break;
	            }
	        }
	        if (idGenero == -1) {
	            JOptionPane.showMessageDialog(null, "Gênero '" + produto.getGenero() + "' não encontrado!");
	            return false;
	        }

	      
	        stmt.setString(1, produto.getProduto()); 
	        stmt.setInt(2, idNovaMidia);             
	        stmt.setInt(3, idGenero);                
	        stmt.setInt(4, produto.getEstoque());    
	        stmt.setFloat(5, produto.getPreço());    
	        stmt.setString(6, produto.getProduto());
	        stmt.setInt(7, idNovaMidia); 

	        int linhasAfetadas = stmt.executeUpdate();
	        if(linhasAfetadas > 0) {
	        	return true;
	        }
	        Conexao.desconectar();

	    } catch (SQLException e) {
	        e.printStackTrace();
	    }
	    return false;
	}

	public int pegarCodMidia(List<Midia> midias2) {
		int codMidia;
		for (int index =  0; index == 2; index++) {
			if (midias2.get(index).equals("CD")) {
				return codMidia = 1;
			} else if (midias2.get(index).equals("DVD")) {
				return codMidia = 2;
			} else if (midias2.get(index).equals("LP")) {
				return codMidia = 3;
			} else {
				JOptionPane.showMessageDialog(null, "Midia invalida");
			}	
		}  
		return 0;
	}
	
	public List<Produto> listar(){
		List<Produto> lista = new ArrayList<>();
		String sql = "SELECT P.nome, M.tipo, G.genero, P.qntdEstoque, P.preco\r\n"
				+ "FROM produto P INNER JOIN midia M ON P.codMidia = M.codMidia\r\n"
				+ "INNER JOIN genero G ON P.codGenero = G.codGenero";
		Conexao.conectar();
		try (Connection conn = Conexao.conexao;
	             PreparedStatement stmt = conn.prepareStatement(sql);
	             ResultSet rs = stmt.executeQuery()) {
	            while (rs.next()) {
	                Produto produto = new Produto(
	                    rs.getString("nome"),
	                    rs.getString("tipo"),
	                    rs.getString("genero"),
	                    rs.getInt("qntdEstoque"),
	                    rs.getFloat("preco")
	                );
	                lista.add(produto);
	            }
	        } catch (SQLException e) {
	            e.printStackTrace();
	        }
	        return lista;
	}
	
	public Produto carregar(String nome, String midia) {
		Produto produto = null;
		String sql = "SELECT P.nome, M.tipo, G.genero, P.qntdEstoque, P.preco\r\n"
				+ "FROM produto P INNER JOIN midia M ON P.codMidia = M.codMidia\r\n"
				+ "INNER JOIN genero G ON P.codGenero = G.codGenero\r\n"
				+ "WHERE P.nome = ? AND M.tipo = ?";
		Conexao.conectar();
        try (Connection conn = Conexao.conexao;
             PreparedStatement stmt = conn.prepareStatement(sql)){
        	stmt.setString(1, nome);
        	stmt.setString(2, midia);
            ResultSet rs = stmt.executeQuery();
            while (rs.next()) {
                produto = new Produto(
                		rs.getString("nome"),
	                    rs.getString("tipo"),
	                    rs.getString("genero"),
	                    rs.getInt("qntdEstoque"),
	                    rs.getFloat("preco")   
                );
            }        
            } catch (SQLException e) {
            e.printStackTrace();
        }
        Conexao.desconectar();
        return produto;
	}
	
	
}


