package model;

public class Detalhes {
	private int codPedido;
    private int codProduto; 
    private int qntdProd;  
	private float valorUni;  
    private float desconto; 
    private float valorTotal;
    
	public Detalhes(int codPedido, int codProduto, int qntdProd, float valorUni, float desconto, float valorTotal) {
		super();
		this.codPedido = codPedido;
		this.codProduto = codProduto;
		this.qntdProd = qntdProd;
		this.valorUni = valorUni;
		this.desconto = desconto;
		this.valorTotal = valorTotal;
	}

	public int getCodPedido() {
		return codPedido;
	}

	public void setCodPedido(int codPedido) {
		this.codPedido = codPedido;
	}

	public int getCodProduto() {
		return codProduto;
	}

	public void setCodProduto(int codProduto) {
		this.codProduto = codProduto;
	}

	public int getQntdProd() {
		return qntdProd;
	}

	public void setQntdProd(int qntdProd) {
		this.qntdProd = qntdProd;
	}

	public float getValorUni() {
		return valorUni;
	}

	public void setValorUni(float valorUni) {
		this.valorUni = valorUni;
	}

	public float getDesconto() {
		return desconto;
	}

	public void setDesconto(float desconto) {
		this.desconto = desconto;
	}

	public float getValorTotal() {
		return valorTotal;
	}

	public void setValorTotal(float valorTotal) {
		this.valorTotal = valorTotal;
	}
    
	
    
}
